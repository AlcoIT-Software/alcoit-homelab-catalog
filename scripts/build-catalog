#!/usr/bin/env python3
"""Build the canonical, deterministic HomeLab application catalog."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
from urllib.parse import urlparse


ROOT = Path(__file__).resolve().parents[1]
IDENTIFIER = re.compile(r"^[a-z0-9][a-z0-9-]{1,62}$")
STORE_IDENTIFIER = re.compile(r"^(?:[a-z0-9]+\.){2,}[a-z0-9]+$")
VERSION = re.compile(r"^[0-9]+(?:\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$")
IMAGE = re.compile(r"^\s*image:\s*([^\s]+)\s*$", re.MULTILINE)
REQUIRED_METADATA = {"id", "store_app_id", "name", "version", "icon"}


def canonical(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def load_json(path: Path) -> dict:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError(f"{path}: expected an object")
    return value


def load_json_value(path: Path) -> object:
    return json.loads(path.read_text(encoding="utf-8"))


def load_store() -> dict:
    config = load_json(ROOT / "store-config.json")
    expected = {"version", "store_id", "name", "description", "maintainer", "url"}
    if set(config) != expected or config["version"] != 2:
        raise ValueError("store-config.json is invalid")
    if not isinstance(config["name"], dict) or not config["name"].get("en_US"):
        raise ValueError("store-config.json must define an en_US name")
    if not isinstance(config["description"], dict) or not config["description"].get("en_US"):
        raise ValueError("store-config.json must define an en_US description")
    validate_https_url(config["url"], "store-config.json: url")

    languages = load_json_value(ROOT / "supported-languages.json")
    categories = load_json_value(ROOT / "category-list.json")
    recommendations = load_json_value(ROOT / "recommend-list.json")
    featured = load_json_value(ROOT / "featured-apps.json")
    if not isinstance(languages, list) or "en_US" not in languages or len(languages) != len(set(languages)):
        raise ValueError("supported-languages.json is invalid")
    if not isinstance(categories, list) or not categories:
        raise ValueError("category-list.json is invalid")
    for category in categories:
        if not isinstance(category, dict) or set(category) != {"name", "font", "description"}:
            raise ValueError("category-list.json contains an invalid category")
    for filename, entries in (("recommend-list.json", recommendations), ("featured-apps.json", featured)):
        if not isinstance(entries, list):
            raise ValueError(f"{filename} is invalid")
        if any(not isinstance(entry, dict) or set(entry) != {"appid"} for entry in entries):
            raise ValueError(f"{filename} contains an invalid application")
    return {
        "config": config,
        "supported_languages": languages,
        "categories": categories,
        "recommendations": recommendations,
        "featured": featured,
    }


def validate_https_url(value: object, field: str) -> str:
    text = str(value)
    parsed = urlparse(text)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError(f"{field} must be an HTTPS URL without credentials")
    return text


def casaos_value(compose: str, field: str) -> str:
    root = re.search(r"(?ms)^x-casaos:\s*\n(?P<body>(?:^[ \t]+.*(?:\n|$))*)", compose)
    match = re.search(
        rf"(?m)^  {re.escape(field)}:\s*([^\s]+)\s*$",
        root.group("body") if root else "",
    )
    if match is None:
        raise ValueError(f"x-casaos.{field} is required")
    return match.group(1).strip('"\'')


def load_application(directory: Path) -> dict:
    manifest_path = directory / "manifest.json"
    compose_path = directory / "docker-compose.yml"
    metadata = load_json(manifest_path)
    if set(metadata) != REQUIRED_METADATA:
        raise ValueError(f"{manifest_path}: expected fields {sorted(REQUIRED_METADATA)}")
    app_id = str(metadata["id"])
    if directory.name.lower().replace("_", "-") != app_id or not IDENTIFIER.fullmatch(app_id):
        raise ValueError(f"{manifest_path}: id must match its normalized directory")
    store_app_id = str(metadata["store_app_id"])
    if not STORE_IDENTIFIER.fullmatch(store_app_id):
        raise ValueError(f"{manifest_path}: store_app_id must be a reverse-domain identifier")
    if not isinstance(metadata["name"], str) or not metadata["name"].strip():
        raise ValueError(f"{manifest_path}: name must be non-empty")
    if not VERSION.fullmatch(str(metadata["version"])):
        raise ValueError(f"{manifest_path}: invalid version")
    validate_https_url(metadata["icon"], f"{manifest_path}: icon")

    compose = compose_path.read_text(encoding="utf-8")
    if not compose.endswith("\n"):
        raise ValueError(f"{compose_path}: file must end with a newline")
    if "x-casaos:" not in compose:
        raise ValueError(f"{compose_path}: x-casaos metadata is required")
    if not re.search(rf"^  id:\s*{re.escape(store_app_id)}\s*$", compose, re.MULTILINE):
        raise ValueError(f"{compose_path}: x-casaos.id must match store_app_id")
    if not re.search(
        rf'^  version:\s*["\']?{re.escape(str(metadata["version"]))}["\']?\s*$',
        compose,
        re.MULTILINE,
    ):
        raise ValueError(f"{compose_path}: x-casaos.version must match the manifest")
    if "privileged: true" in compose.lower():
        raise ValueError(f"{compose_path}: privileged containers are forbidden")
    images = IMAGE.findall(compose)
    if not images:
        raise ValueError(f"{compose_path}: at least one image is required")
    for image in images:
        if image.endswith(":latest") or (":" not in image and "@sha256:" not in image):
            raise ValueError(f"{compose_path}: image must be pinned: {image}")
    return {
        "id": app_id,
        "name": metadata["name"],
        "version": metadata["version"],
        "icon": metadata["icon"],
        "compose": compose,
    }


def build() -> dict:
    release = load_json(ROOT / "catalog.release.json")
    if set(release) != {"schema_version", "version"}:
        raise ValueError("catalog.release.json has unsupported fields")
    if release["schema_version"] != 2 or not VERSION.fullmatch(str(release["version"])):
        raise ValueError("catalog.release.json is invalid")
    applications = [
        load_application(path)
        for path in sorted((ROOT / "Apps").iterdir())
        if path.is_dir()
    ]
    identifiers = [app["id"] for app in applications]
    if not applications or len(identifiers) != len(set(identifiers)):
        raise ValueError("catalog must contain unique applications")
    store = load_store()
    applications_by_legacy_id = {
        casaos_value(app["compose"], "main"): app for app in applications
    }
    for collection in (store["recommendations"], store["featured"]):
        if any(entry["appid"] not in applications_by_legacy_id for entry in collection):
            raise ValueError("store lists reference an unknown CasaOS application")
    for entry in store["featured"]:
        app = applications_by_legacy_id[entry["appid"]]
        thumbnail = validate_https_url(
            casaos_value(app["compose"], "thumbnail"),
            f"{entry['appid']}: x-casaos.thumbnail",
        )
        if "AlcoIT-Software/alcoit-homelab-catalog@main/Apps/" not in thumbnail:
            raise ValueError("featured thumbnails must be owned by the catalog repository")
    return {**release, "store": store, "apps": applications}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=ROOT / "dist" / "catalog.json")
    arguments = parser.parse_args()
    catalog = build()
    arguments.output.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(catalog, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    arguments.output.write_text(payload, encoding="utf-8")
    digest = "sha256:" + hashlib.sha256(payload.encode()).hexdigest()
    arguments.output.with_suffix(arguments.output.suffix + ".sha256").write_text(
        digest + "\n", encoding="utf-8"
    )
    print(f"Built {arguments.output} ({len(catalog['apps'])} applications, {digest})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
